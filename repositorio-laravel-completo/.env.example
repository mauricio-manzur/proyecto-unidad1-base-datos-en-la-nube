APP_NAME="Repositorio"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://TU-IP-O-DOMINIO
APP_LOCALE=es

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=<endpoint-de-RDS>
DB_PORT=3306
DB_DATABASE=repositorio_archivos
DB_USERNAME=admin
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
AUTH_MODEL=App\Models\Usuario

FILESYSTEM_DISK=s3
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=<nombre-del-bucket>
# NO pongas AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY: la EC2 usa el IAM Role
